<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="142dp"
        android:layout_height="185dp"
        android:background="@drawable/CardBackground"
        android:orientation="vertical"
        android:clipChildren="false">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="25dp"
			android:orientation="horizontal">

			<TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Card"
                android:textSize="12dp"
				android:gravity="center"
                android:textColor="@android:color/white"
                android:id="@+id/tvCardName"/>
			
		</LinearLayout>
		
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="90.5dp"
            android:id="@+id/ivCardPortrait"
            android:src="@drawable/defaultportrait"
            /> Note to keep Pixelart consistant across 125x80, focus on horizontal coverage though the sides of the portrait are blocked (Conversion rate of 1 x 1.5625)
        <TextView
            android:layout_width="match_parent"
            android:layout_height="45dp"
			android:layout_marginTop="4dp"
            android:id="@+id/tvCardAbility"
            android:text="The monster does"
            android:textSize="6.5dp"
            android:gravity="center"
            android:textColor="@android:color/white"/> Text view for abilities
			
		<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="25dp"
		android:orientation="horizontal"
		android:gravity="center">



		<TextView
			android:layout_width="21dp"
			android:layout_height="21dp"
			android:background="@drawable/IconATK"
			android:textSize="20dp"
			android:text="1"
                
			android:layout_alignParentLeft="true"
			android:gravity="center"
			android:textColor="@android:color/white"
			android:id="@+id/tvCardAT"/>

			<TextView
				android:layout_width="21dp"
				android:layout_height="21dp"
				android:background="@drawable/IconSPD"
				android:textSize="20dp"
				android:text="1"
                
				android:layout_centerInParent="true"
				android:gravity="center"
				android:textColor="@android:color/white"
				android:id="@+id/tvCardSP"/>

		<TextView
			android:layout_width="21dp"
			android:layout_height="21dp"
			android:background="@drawable/IconHP"
			android:textSize="20dp"
			android:text="1"
                
			android:layout_alignParentRight="true"
			android:gravity="center"
			android:textColor="@android:color/white"
			android:id="@+id/tvCardHP"/>
	</RelativeLayout>
	    
    </LinearLayout>
</LinearLayout>
