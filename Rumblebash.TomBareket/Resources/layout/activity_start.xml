<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rlStartMenu"
    android:background="@android:color/holo_blue_light"
    android:orientation="vertical">
    
    <ImageView
        android:layout_width="400dp"
        android:layout_height="240dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/RumblebashTitle"
        android:id="@+id/ivGameTitle"/>

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:src="@drawable/slotviewtest"
        android:layout_marginTop="275dp"
        android:text="Play Game"
        android:textSize="20dp"
        android:layout_marginLeft="65dp"
        android:id="@+id/btnPlay"/>

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:src="@drawable/slotviewtest"
        android:layout_marginTop="385dp"
        android:text="Game Settings"
        android:textSize="20dp"
        android:layout_marginLeft="65dp"
        android:id="@+id/btnOptions"/>

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:src="@drawable/slotviewtest"
        android:layout_marginTop="495dp"
        android:text="High Scores"
        android:textSize="20dp"
        android:layout_marginLeft="65dp"
        android:id="@+id/btnHighScore"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#340336"
        android:gravity="center"
        android:layout_centerInParent="true"
        >
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026 Tom Bareket"
        android:id="@+id/tvCreatorName"
        android:textColor="@android:color/white"
        android:textSize="20dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v0.2 Combat Build"
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:id="@+id/tvVersionName"
        />
    </LinearLayout>
    
 
</RelativeLayout>